context acme
layout collocated

# --- Identifiers (newtypes over Text with typeid-style prefixes) ---
id WidgetId  prefix=wid
id CommandId prefix=cmd

# --- Closed enumerations (Ctor=wire-spelling). Reference a closed enum from a
# --- payload field with an explicit `field:EnumName` annotation (a bare field
# --- only resolves to an enum when its PascalCased name equals the enum name). ---
enum WidgetKind {
  Standard=standard Premium=premium
}

# --- First-class read model backing the `widgets` projection. Declaring the node
# --- (rather than a standalone projection) is what makes registration, schema
# --- identity, Strong consistency, and rebuild helpers available. `shape` is the
# --- captured fnv1a digest of `table|column:type:req|...`; the checker rejects
# --- drift, so re-run `keiro-dsl check` after every column change and bump
# --- `version` when the table shape really changed. ---
readmodel widgets {
  table = "widgets"
  schema = "acme"
  columns {
    widget_id text required
    name text required
    kind text required
    status text required
    created_by text required
    created_at timestamptz
    stream_version bigint required
  }
  version = 1
  shape = "fnv1a:421d16373630a9b1"
  consistency = Strong
  scope = category "widget"
  feed = subscription
  subscription = "acme-widgets-sub"
}

aggregate Widget
  regs
    widgetId    WidgetId     = placeholder
    widgetState WidgetVertex = Active
  states Active Shelved!

  command CreateWidget  { widgetId kind:WidgetKind name:Text createdBy commandId }
  command ArchiveWidget { widgetId archivedBy commandId }

  event WidgetCreated  = fields(CreateWidget)
  event WidgetArchived = fields(ArchiveWidget)

  Active -- CreateWidget  --> emit WidgetCreated  ; goto Active
  Active -- ArchiveWidget --> emit WidgetArchived ; goto Shelved

  wire kind=ctorName fields=camelCase schemaVersion=1
  projection widgets consistency=Strong key=widgetId
    status-map {
      WidgetCreated=>active
      WidgetArchived=>archived
    }

# --- Operations: the intended API surface. A `command` operation becomes a
# --- servant route that issues a command; a `query` operation reads a projection. ---
operation CreateWidget
  command on Widget
    stream from widgetId via widgetStream
    project [ widgets ]

operation GetWidget
  query widgets
    input WidgetId
    result Maybe WidgetView
    consistency Strong
