  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "state",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "secret": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "Tree": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tree"
            }
          }
        }
      },
      "Open": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string"
          }
        }
      },
      "Overlap": {
        "oneOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "integer"
          }
        ]
      },
      "Inclusive": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "integer"
          }
        ]
      },
      "Combined": {
        "allOf": [
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "a"
            ],
            "properties": {
              "a": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "b"
            ],
            "properties": {
              "b": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "Tagged": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "meows"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cat"
                ]
              },
              "meows": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "barks"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "dog"
                ]
              },
              "barks": {
                "type": "boolean"
              }
            }
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      }
    }
  }
}
