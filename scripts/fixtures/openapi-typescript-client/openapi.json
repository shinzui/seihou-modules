    "/inclusive": {
      "get": {
        "operationId": "getInclusive",
        "responses": {
          "200": {
            "description": "Inclusive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inclusive"
                }
              }
            }
          }
        }
      }
    },
    "/combined": {
      "get": {
        "operationId": "getCombined",
        "responses": {
          "200": {
            "description": "Combined",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Combined"
                }
              }
            }
          }
        }
      }
    },
    "/tagged": {
      "get": {
        "operationId": "getTagged",
        "responses": {
          "200": {
            "description": "Tagged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tagged"
                }
              }
            }
          }
        }
      }
    },
    "/primitive": {
      "get": {
        "operationId": "getPrimitive",
        "responses": {
