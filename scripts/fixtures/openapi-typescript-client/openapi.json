                  "$ref": "#/components/schemas/Tree"
                }
              }
            }
          }
        }
      }
    },
    "/open": {
      "get": {
        "operationId": "getOpen",
        "responses": {
          "200": {
            "description": "Open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Open"
                }
              }
            }
          }
        }
      }
    },
    "/overlap": {
      "get": {
        "operationId": "getOverlap",
        "responses": {
          "200": {
            "description": "Overlap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overlap"
                }
              }
            }
          }
