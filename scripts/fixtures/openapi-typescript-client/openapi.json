    "/array": {
      "get": {
        "operationId": "getArray",
        "responses": {
          "200": {
            "description": "Array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Widget"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/empty": {
      "get": {
        "operationId": "getEmpty",
        "responses": {
